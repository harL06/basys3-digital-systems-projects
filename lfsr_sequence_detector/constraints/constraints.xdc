## Clock signal
set_property PACKAGE_PIN W5 [get_ports CCLK]
set_property IOSTANDARD LVCMOS33 [get_ports CCLK]
create_clock -period 10.000 -name sys_clk_pin -waveform {0.000 5.000} -add [get_ports CCLK]

set_property IOSTANDARD LVCMOS33 [get_ports lfsr_max_tick]
set_property PACKAGE_PIN L1 [get_ports lfsr_max_tick]
